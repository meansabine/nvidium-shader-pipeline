#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std140, binding = 3) uniform SceneUniforms {
    mat4  u_ViewMatrix;
    mat4  u_ProjMatrix;
    mat4  u_ViewProjMatrix;
    mat4  u_InvViewProjMatrix;
    mat4  u_CascadeViewProj[3];
    vec4  u_CascadeSplits;
    vec4  u_SunDirection;
    vec4  u_SunColor;
    vec4  u_AmbientColor;
    vec4  u_CameraPos;
    vec2  u_ScreenSize;
    vec2  _pad0;
    float u_Time;
    int   u_FrameIndex;
    float u_FogStart;
    float u_FogEnd;
    vec4  u_FogColor;
};

layout(binding = 1) uniform sampler2D u_NormalMetallic;
layout(binding = 3) uniform sampler2D u_Depth;
layout(r16f, binding = 0) uniform writeonly image2D u_AoOutput;

const float PI = 3.14159265359;

vec3 reconstructViewPos(vec2 uv, float depth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 worldPosH = u_InvViewProjMatrix * clip;
    vec3 worldPos = worldPosH.xyz / worldPosH.w;
    return (u_ViewMatrix * vec4(worldPos, 1.0)).xyz;
}

float interleavedGradientNoise(vec2 pixelCoord) {
    vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
    float frameOffset = float(u_FrameIndex % 64) * 5.588238;
    return fract(magic.z * fract(dot(pixelCoord + frameOffset, magic.xy)));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_ScreenSize.x) || pixel.y >= int(u_ScreenSize.y)) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / u_ScreenSize;
    float centerDepth = texture(u_Depth, uv).r;
    if (centerDepth >= 0.999999) {
        imageStore(u_AoOutput, pixel, vec4(1.0));
        return;
    }

    vec3 viewPos = reconstructViewPos(uv, centerDepth);
    vec3 worldNormal = normalize(texture(u_NormalMetallic, uv).xyz * 2.0 - 1.0);
    vec3 viewNormal = normalize(mat3(u_ViewMatrix) * worldNormal);
    vec3 viewDir = normalize(-viewPos);

    float noise = interleavedGradientNoise(vec2(pixel));
    float phi = noise * PI;
    vec2 sliceDir = vec2(cos(phi), sin(phi));

    float worldRadius = 1.35;
    float screenRadius = clamp((worldRadius * u_ProjMatrix[0][0]) / max(-viewPos.z, 0.5), 2.0, 24.0);
    vec2 texelSize = 1.0 / u_ScreenSize;

    float horizonCosPos = -1.0;
    float horizonCosNeg = -1.0;

    for (int step = 1; step <= 4; ++step) {
        float stepScale = (float(step) - 0.5 + fract(noise * 4.37)) / 4.0;
        vec2 offset = sliceDir * texelSize * (screenRadius * stepScale);

        // Positive direction
        vec2 uvPos = clamp(uv + offset, vec2(0.001), vec2(0.999));
        float dPos = texture(u_Depth, uvPos).r;
        vec3 sPos = reconstructViewPos(uvPos, dPos) - viewPos;
        float lenPos = length(sPos);
        if (lenPos > 0.001) {
            float weight = clamp(1.0 - lenPos / worldRadius, 0.0, 1.0);
            horizonCosPos = max(horizonCosPos, mix(-1.0, dot(sPos / lenPos, viewDir), weight));
        }

        // Negative direction
        vec2 uvNeg = clamp(uv - offset, vec2(0.001), vec2(0.999));
        float dNeg = texture(u_Depth, uvNeg).r;
        vec3 sNeg = reconstructViewPos(uvNeg, dNeg) - viewPos;
        float lenNeg = length(sNeg);
        if (lenNeg > 0.001) {
            float weight = clamp(1.0 - lenNeg / worldRadius, 0.0, 1.0);
            horizonCosNeg = max(horizonCosNeg, mix(-1.0, dot(sNeg / lenNeg, viewDir), weight));
        }
    }

    float hPos = acos(clamp(horizonCosPos, -1.0, 1.0));
    float hNeg = acos(clamp(horizonCosNeg, -1.0, 1.0));
    float visibility = clamp((sin(hPos) + sin(hNeg) + (hPos + hNeg) * cos(viewNormal.z)) * 0.25, 0.15, 1.0);

    imageStore(u_AoOutput, pixel, vec4(visibility));
}
