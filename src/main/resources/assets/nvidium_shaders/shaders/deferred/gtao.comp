#version 460 core

// ============================================================================
// Nvidium Shader Pipeline (NSP) - Ground Truth Ambient Occlusion (GTAO) Compute
// Horizon-based screen-space ambient occlusion with IGN spatial-temporal jitter.
// ============================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std140, binding = 3) uniform SceneUniforms {
    mat4  u_ViewMatrix;
    mat4  u_ProjMatrix;
    mat4  u_ViewProjMatrix;
    mat4  u_InvViewProjMatrix;
    mat4  u_CascadeViewProj[3];
    vec4  u_CascadeSplits;
    vec4  u_SunDirection;
    vec4  u_SunColor;
    vec4  u_AmbientColor;
    vec4  u_CameraPos;
    vec2  u_ScreenSize;
    vec2  _pad0;
    float u_Time;
    int   u_FrameIndex;
    float u_FogStart;
    float u_FogEnd;
    vec4  u_FogColor;
};

layout(binding = 1) uniform sampler2D u_NormalMetallic;
layout(binding = 3) uniform sampler2D u_Depth;
layout(binding = 0, r8) uniform writeonly image2D u_AoOutput;

const float PI = 3.14159265359;
const int   GTAO_SLICES = 3;
const int   GTAO_STEPS  = 6;

vec3 reconstructViewPos(vec2 uv, float depth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 worldPosH = u_InvViewProjMatrix * clip;
    vec3 worldPos = worldPosH.xyz / worldPosH.w;
    return (u_ViewMatrix * vec4(worldPos, 1.0)).xyz;
}

float interleavedGradientNoise(vec2 pixelCoord) {
    vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
    float frameOffset = float(u_FrameIndex % 64) * 5.588238;
    return fract(magic.z * fract(dot(pixelCoord + frameOffset, magic.xy)));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screenSize = ivec2(u_ScreenSize);
    if (pixel.x >= screenSize.x || pixel.y >= screenSize.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / u_ScreenSize;
    float centerDepth = texture(u_Depth, uv).r;
    if (centerDepth >= 0.999999) {
        imageStore(u_AoOutput, pixel, vec4(1.0));
        return;
    }

    vec3 viewPos = reconstructViewPos(uv, centerDepth);
    vec3 worldNormal = normalize(texture(u_NormalMetallic, uv).xyz * 2.0 - 1.0);
    vec3 viewNormal = normalize(mat3(u_ViewMatrix) * worldNormal);
    vec3 viewDir = normalize(-viewPos);

    float ignAngle = interleavedGradientNoise(vec2(pixel));
    float ignStep  = fract(ignAngle * 3.71828);

    float radiusPixels = clamp(24.0 / max(-viewPos.z, 0.5), 3.0, 36.0);
    vec2  texelSize = 1.0 / u_ScreenSize;

    float visibility = 0.0;

    for (int slice = 0; slice < GTAO_SLICES; ++slice) {
        float phi = (PI / float(GTAO_SLICES)) * (float(slice) + ignAngle);
        vec2 omega = vec2(cos(phi), sin(phi));

        float maxHorizonPos = -1.0;
        float maxHorizonNeg = -1.0;

        for (int stepIdx = 1; stepIdx <= GTAO_STEPS; ++stepIdx) {
            float s = (float(stepIdx) - 0.5 + ignStep * 0.5) / float(GTAO_STEPS);
            vec2 offsetUv = omega * (s * radiusPixels) * texelSize;

            // Positive direction
            vec2 uvPos = clamp(uv + offsetUv, vec2(0.001), vec2(0.999));
            float dPos = texture(u_Depth, uvPos).r;
            vec3 samplePos = reconstructViewPos(uvPos, dPos) - viewPos;
            float distPos = length(samplePos);
            if (distPos > 1e-4) {
                float falloff = clamp(1.0 - (distPos / 2.5), 0.0, 1.0);
                float h = dot(samplePos / distPos, viewDir);
                maxHorizonPos = max(maxHorizonPos, mix(-1.0, h, falloff));
            }

            // Negative direction
            vec2 uvNeg = clamp(uv - offsetUv, vec2(0.001), vec2(0.999));
            float dNeg = texture(u_Depth, uvNeg).r;
            vec3 sampleNeg = reconstructViewPos(uvNeg, dNeg) - viewPos;
            float distNeg = length(sampleNeg);
            if (distNeg > 1e-4) {
                float falloff = clamp(1.0 - (distNeg / 2.5), 0.0, 1.0);
                float h = dot(sampleNeg / distNeg, viewDir);
                maxHorizonNeg = max(maxHorizonNeg, mix(-1.0, h, falloff));
            }
        }

        float hPos = acos(clamp(maxHorizonPos, -1.0, 1.0));
        float hNeg = acos(clamp(maxHorizonNeg, -1.0, 1.0));
        float sliceVis = 0.5 * ((cos(hPos) + cos(hNeg)) + 1.0);
        visibility += clamp(sliceVis, 0.0, 1.0);
    }

    float ao = clamp(visibility / float(GTAO_SLICES), 0.05, 1.0);
    imageStore(u_AoOutput, pixel, vec4(ao));
}
